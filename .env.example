# ---- LLM providers ----------------------------------------------------------
# 最低1つのVision対応プロバイダのキーが必要です。既定ではOpenAIのみで動作します。
OPENAI_API_KEY=
# （互換）OPENAI_KEY でも可
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=low        # gpt-5系: minimal | low | medium | high | default(未指定)

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Neon AI Gateway などOpenAI互換エンドポイント（provider名 "gateway"）
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=

# Analyzer は2つ以上を推奨（カンマ区切り、provider:model 形式）
ANALYZER_MODELS=openai:gpt-5.4-mini,openai:gpt-4.1
JUDGE_MODEL=openai:gpt-5.4
# 例: ANALYZER_MODELS=openai:gpt-5.4-mini,anthropic:claude-sonnet-5,google:gemini-2.5-flash

# ---- Database (Neon Postgres) ----------------------------------------------
# 未設定の場合はインメモリ保存（開発用。再起動で消えます）
DATABASE_URL=

# ---- Object storage (optional) ---------------------------------------------
# S3互換（Neon Object Storage など）。未設定の場合はPostgresのbyteaに保存します。
# NEON_STORAGE_ENDPOINT=
# NEON_STORAGE_BUCKET=
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=
# NEON_STORAGE_REGION=auto

# ---- Versioning (recorded with every analysis) ------------------------------
PROMPT_VERSION=kasumigaseki-master-v1.2
# RUBRIC_VERSION / ALGORITHM_VERSION はコード内の定数（lib/scoring）で管理します

# ---- Tuning (optional) ------------------------------------------------------
# LLM_TIMEOUT_MS=120000        # 1回のLLM呼び出しの上限
# ANALYSIS_BUDGET_MS=270000    # 1リクエスト全体の上限（Vercel maxDuration=300 未満に）
# LLM_MAX_OUTPUT_TOKENS=6000
# LLM_MAX_ATTEMPTS=2
# IMAGE_MAX_DIMENSION=2048
# LLM_IMAGE_MAX_DIMENSION=1568
# RATE_LIMIT_MAX=10             # IPあたり（メモリ + Postgres の rate_limits テーブルで共有）
# RATE_LIMIT_WINDOW_MS=600000
